# Copy to .env.local for development. Production values live in the hosting provider.

# Neon Postgres — pooled URL for the app, direct URL for migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/wanna_space?sslmode=verify-full&channel_binding=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/wanna_space?sslmode=verify-full&channel_binding=require"

# Better Auth — generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth — redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
# Optional in development (the Google button hides when unset), required in production.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend — optional in development (emails print to the server console), required in production.
RESEND_API_KEY=""
EMAIL_FROM="Wanna Space <hello@your-verified-domain.com>"

# Cloudinary — Vault uploads and stored link previews (ADR 0013). Optional: without it the
# Vault still saves links, notes and snippets, and uploads stay switched off.
# Either the single URL from the Cloudinary console (API Keys page) …
CLOUDINARY_URL=""
# … or the three parts:
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
